{
  "name": "api",
  "version": "1.0.0",
  "description": "modelo de backend para api de creche",
  "main": "index.js",
  "scripts": {
    "dev": "tsx watch src/server.ts",
    "build": "tsc --noEmit && esbuild src/server.ts --bundle --platform=node --format=esm --packages=external --alias:@creche/shared=../shared/src --outfile=dist/server.js --sourcemap",
    "typecheck": "tsc --noEmit",
    "test": "tsx --test --test-concurrency=1 tests/*.test.ts",
    "db:status": "prisma migrate status",
    "db:baseline": "prisma migrate resolve --applied 20261124204007_init",
    "db:migrate": "prisma migrate deploy",
    "test:presencas": "tsx --test tests/presencas.test.ts",
    "test:presencas:integration": "tsx --test tests/presencas.integration.test.ts",
    "start": "node dist/server.js",
    "postinstall": "prisma skills sync || exit 0"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "type": "module",
  "dependencies": {
    "@asteasolutions/zod-to-openapi": "^9.1.0",
    "@creche/shared": "*",
    "@prisma/adapter-pg": "^7.10.1",
    "@prisma/client": "^7.10.1",
    "bcryptjs": "^3.0.3",
    "cors": "^2.8.6",
    "dotenv": "^18.0.9",
    "express": "^5.3.0",
    "pg": "^8.23.1",
    "swagger-ui-express": "^5.0.1",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.6",
    "@types/pg": "^8.23.1",
    "@types/swagger-ui-express": "^4.1.8",
    "tsx": "^4.23.15",
    "esbuild": "^0.27.0"
  }
}
