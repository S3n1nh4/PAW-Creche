generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

model Admin {
  contaId   Int? @unique @map("conta_id")
  conta     Conta? @relation(fields: [contaId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  id        Int      @id @default(autoincrement())
  nome      String
  /// Espelho de compatibilidade; a identidade e o email único estão em Conta.
  email     String
  senhaHash String   @map("senha_hash")
  ativo     Boolean  @default(true)
  criadoEm  DateTime @default(now()) @map("criado_em") @db.Timestamptz

  presencasCuidador PresencaCuidador[]

  @@map("admin")
}

model Cuidador {
  contaId      Int? @unique @map("conta_id")
  conta        Conta? @relation(fields: [contaId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  id           Int      @id @default(autoincrement())
  nome         String
  /// Espelho de compatibilidade; a identidade e o email único estão em Conta.
  email        String
  senhaHash    String   @map("senha_hash")
  telefone     String?
  dataAdmissao DateTime @default(now()) @map("data_admissao") @db.Date
  salarioBase  Decimal  @default(0) @map("salario_base") @db.Decimal(12, 2)
  ativo        Boolean  @default(true)
  criadoEm     DateTime @default(now()) @map("criado_em") @db.Timestamptz

  turmas            TurmaCuidador[]
  presencas         Presenca[]
  presencasCuidador PresencaCuidador[]
  comportamentos    Comportamento[]

  @@map("cuidador")
}

model Conta {
  id Int @id @default(autoincrement())
  email String @unique
  senhaHash String @map("senha_hash")
  perfil String
  ativo Boolean @default(true)
  versaoSessao Int @default(1) @map("versao_sessao")
  criadoEm DateTime @default(now()) @map("criado_em") @db.Timestamptz
  admin Admin?
  cuidador Cuidador?
  @@map("conta")
}

model Turma {
  id        Int      @id @default(autoincrement())
  nome      String
  anoLetivo Int      @map("ano_letivo")
  turno     String
  ativo     Boolean  @default(true)
  criadoEm  DateTime @default(now()) @map("criado_em") @db.Timestamptz

  cuidadores TurmaCuidador[]
  alunos     Aluno[]
  presencas  Presenca[]

  @@unique([nome, anoLetivo, turno])
  @@map("turma")
}

model TurmaCuidador {
  turmaId    Int @map("turma_id")
  cuidadorId Int @map("cuidador_id")

  turma    Turma    @relation(fields: [turmaId], references: [id])
  cuidador Cuidador @relation(fields: [cuidadorId], references: [id])

  @@id([turmaId, cuidadorId])
  @@index([cuidadorId], map: "turma_cuidador_cuidador_idx")
  @@map("turma_cuidador")
}

model Aluno {
  id                  Int      @id @default(autoincrement())
  nome                String
  dataNascimento      DateTime @map("data_nascimento") @db.Date
  turmaId             Int?     @map("turma_id")
  responsavelNome     String   @map("responsavel_nome")
  responsavelTelefone String   @map("responsavel_telefone")
  responsavelEmail    String?  @map("responsavel_email")
  observacoes         String?
  ativo               Boolean  @default(true)
  criadoEm            DateTime @default(now()) @map("criado_em") @db.Timestamptz

  turma          Turma?          @relation(fields: [turmaId], references: [id])
  presencas      Presenca[]
  comportamentos Comportamento[]

  @@index([turmaId], map: "aluno_turma_idx")
  @@map("aluno")
}

model Presenca {
  id                      Int      @id @default(autoincrement())
  alunoId                 Int      @map("aluno_id")
  turmaId                 Int      @map("turma_id")
  data                    DateTime @default(now()) @db.Date
  status                  String
  observacao              String?
  registradoPorCuidadorId Int      @map("registrado_por_cuidador_id")
  criadoEm                DateTime @default(now()) @map("criado_em") @db.Timestamptz

  aluno    Aluno    @relation(fields: [alunoId], references: [id])
  turma    Turma    @relation(fields: [turmaId], references: [id])
  cuidador Cuidador @relation(fields: [registradoPorCuidadorId], references: [id])

  @@unique([alunoId, data])
  @@index([turmaId, data], map: "presenca_turma_data_idx")
  @@index([registradoPorCuidadorId], map: "presenca_autor_idx")
  @@map("presenca")
}

model PresencaCuidador {
  id                   Int       @id @default(autoincrement())
  cuidadorId           Int       @map("cuidador_id")
  data                 DateTime  @default(now()) @db.Date
  status               String
  entrada              DateTime? @db.Timestamptz
  saida                DateTime? @db.Timestamptz
  observacao           String?
  registradoPorAdminId Int       @map("registrado_por_admin_id")
  criadoEm             DateTime  @default(now()) @map("criado_em") @db.Timestamptz

  cuidador Cuidador @relation(fields: [cuidadorId], references: [id])
  admin    Admin    @relation(fields: [registradoPorAdminId], references: [id])

  @@unique([cuidadorId, data])
  @@index([registradoPorAdminId], map: "presenca_cuidador_admin_idx")
  @@map("presenca_cuidador")
}

model Comportamento {
  id         Int      @id @default(autoincrement())
  alunoId    Int      @map("aluno_id")
  cuidadorId Int      @map("cuidador_id")
  data       DateTime @default(now()) @db.Date
  descricao  String
  criadoEm   DateTime @default(now()) @map("criado_em") @db.Timestamptz

  aluno    Aluno    @relation(fields: [alunoId], references: [id])
  cuidador Cuidador @relation(fields: [cuidadorId], references: [id])

  @@index([alunoId, data], map: "comportamento_aluno_data_idx")
  @@index([cuidadorId], map: "comportamento_cuidador_idx")
  @@map("comportamento")
}
